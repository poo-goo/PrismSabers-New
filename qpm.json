{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "PrismSabers",
    "id": "prism-sabers",
    "version": "0.1.0",
    "additionalData": {
      "overrideSoName": "libprism-sabers.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "python ./extern/includes/mod-scripts/shared/build.py $0:?"
      ],
      "copy": [
        "python ./extern/includes/mod-scripts/shared/cpy.py $0:?"
      ],
      "debug": [
        "python ./extern/includes/mod-scripts/shared/debug.py $0:?"
      ],
      "log": [
        "python ./extern/includes/mod-scripts/shared/log.py $0:?"
      ],
      "profile": [
        "python ./extern/includes/mod-scripts/shared/profile.py $0:?"
      ],
      "restart": [
        "python ./extern/includes/mod-scripts/shared/restart.py $0:?"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs",
      "."
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./PrismSabers.qmod"
  },
  "dependencies": [
    {
      "id": "mod-scripts",
      "versionRange": "^1.0.2",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "flamingo",
      "versionRange": "^1.2.1",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.1.0",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4502.2.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.1",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.2",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^3.0.0",
      "additionalData": {}
    },
    {
      "id": "reflectcpp",
      "versionRange": "^0.25.0",
      "additionalData": {}
    },
    {
      "id": "sombrero",
      "versionRange": "^0.1.43",
      "additionalData": {
        "private": true
      }
    }
  ]
}
